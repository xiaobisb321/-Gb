-- 6. 抖动特效（所有角色 & 车辆）
-- ============================================================
local shakeActive = false
local shakeConnection = nil
local shakeData = {} -- 存储每个部件的原始状态

local SHAKE_SPEED = 12          -- 抖动速度
local SHAKE_AMPLITUDE = 0.8     -- 上下偏移幅度（Studs）
local SHAKE_SCALE_Y = 0.3       -- Y 轴缩放幅度（1 ± 0.3 即 0.7 ~ 1.3）

-- 收集所有角色和车辆的主要部件
local function collectTargets()
    local targets = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if not obj:IsA("Model") then continue end

        local isCharacter = obj:FindFirstChildOfClass("Humanoid") ~= nil
        local isVehicle = obj:FindFirstChildOfClass("VehicleSeat") ~= nil

        if isCharacter or isVehicle then
            local part = obj.PrimaryPart
                or obj:FindFirstChild("HumanoidRootPart")
                or obj:FindFirstChildWhichIsA("BasePart", true)
            if part and part:IsA("BasePart") then
                targets[part] = {
                    Size = part.Size,
                    CFrame = part.CFrame,
                }
            end
        end
    end
    return targets
end

local function startShake()
    if shakeActive then return end
    shakeData = collectTargets()
    if next(shakeData) == nil then
        statusLabel.Text = "状态：未找到角色或车辆"
        return
    end

    shakeActive = true
    statusLabel.Text = "状态：运行中 ✦"
    shakeButton.Text = "车辆人物抖动 (开)"

    shakeConnection = RunService.Heartbeat:Connect(function()
        local t = tick() * SHAKE_SPEED
        local offsetY = math.sin(t) * SHAKE_AMPLITUDE
        local scaleY = 1 + math.sin(t) * SHAKE_SCALE_Y

        for part, data in pairs(shakeData) do
            if part.Parent then
                part.Size = Vector3.new(data.Size.X, data.Size.Y * scaleY, data.Size.Z)
                part.CFrame = data.CFrame * CFrame.new(0, offsetY, 0)
            end
        end
    end)
end

local function stopShake()
    if not shakeActive then return end
    shakeActive = false
    shakeButton.Text = "车辆人物抖动"
    statusLabel.Text = "状态：已停止"

    if shakeConnection then
        shakeConnection:Disconnect()
        shakeConnection = nil
    end

    -- 恢复原始状态
    for part, data in pairs(shakeData) do
        if part.Parent then
            part.Size = data.Size
            part.CFrame = data.CFrame
        end
    end
    shakeData = {}
end

shakeButton.MouseButton1Click:Connect(function()
    if shakeActive then
        stopShake()
    else
        startShake()
    end
end)

