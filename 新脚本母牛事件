-- FPS 计算（每 1 秒刷新一次）
local frameCount = 0
local elapsedTime = 0
RunService.RenderStepped:Connect(function(dt)
    frameCount = frameCount + 1
    elapsedTime = elapsedTime + dt
    if elapsedTime >= 1 then
        local fps = math.floor(frameCount / elapsedTime + 0.5)
        fpsLabel.Text = string.format("FPS: %d", fps)
        frameCount = 0
        elapsedTime = 0
    end
end)

